{
  "trigger": "Caps hold",
  "keys": {
    "1": {"send": "f1"},
    "2": {"send": "f2"},
    "3": {"send": "f3"},
    "4": {"tap": "Raycast"},
    "5": {"tap": "Raycast"},
    "6": {"send": "f6"},
    "7": {"send": "f7"},
    "8": {"tap": "F8"},
    "9": {"tap": "Shottr", "note": "Shottr で window をキャプチャ"},
    "0": {"tap": "ShotWin", "note": "screenshot.sh -w（window）"},
    "slash": {"tap": "ShotArea", "note": "screenshot.sh -i（範囲選択）"},
    "equal": {"tap": "F12"},
    "l": {"tap": "NewTab", "note": "⌘T。terminal では tmux の new-window（prefix t）"},
    "e": {"tap": "TabPrev", "note": "⌃⇧Tab。terminal では tmux の previous-window（⌃⇧←）"},
    "i": {"tap": "CloseTab", "note": "⌘W。terminal では tmux の kill-pane（prefix w）"},
    "a": {"tap": "TabNext", "note": "⌃Tab。terminal では tmux の next-window（⌃⇧→）"},
    "z": {"tap": "⌘1"},
    "x": {"tap": "⌘2"},
    "c": {"tap": "⌘3"},
    "up": {"send": "f3"},
    "caps": {"tap": "Util", "held": true},
    "left": {"send": "f1"},
    "down": {"tap": "MC"},
    "right": {"send": "f2"}
  }
}
